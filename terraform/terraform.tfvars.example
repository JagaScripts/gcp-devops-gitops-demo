# Copy this file to terraform.tfvars (ignored by git) and set your GCP project values.
project_id                = "your-gcp-project-id"
region                    = "us-central1"
environment               = "dev"
service_name              = "gcp-devops-demo"
artifact_registry_repo_id = "devops-demo-images"
container_image           = "us-docker.pkg.dev/cloudrun/container/hello"
container_port            = 8080
allow_unauthenticated     = true
billing_account_id        = ""
budget_amount_eur         = 1
